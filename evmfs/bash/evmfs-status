    "call" \
    "method" \
    "bulk"
  _tasks_parallel_auto_detect
  _set_override \
    "retries" \
    "max" \
    "300"
  _set_override \
    "call" \
    "timeout" \
    "300000"
  _set_override \
    "user" \
    "level" \
    "n"
  _set_override \
    "call" \
    "auth" \
    "n"
  _deployments_dir_auto_detect \
    "evmfs" \
    "${user_level}"
  if (( "${networks_amount}" < 1 )); then
    _network_auto_detect \
      "FileSystem" \
      "${deployments_dir}" \
      "${user_level}"
    target_networks+=(
      "${target_network}"
    )
    target_network=""
    networks_amount="${#target_networks[@]}"
  fi
  if [[ "${networks_amount}" == 1 ]]; then
