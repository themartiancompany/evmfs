_stats_display() {
  local \
    _file \
    _hash \
    _hashes=() \
    _hashes_active=() \
    _hashes_locking=() \
    _hashes_publishing=() \
    _msg=()
  declare \
    -A \
    _hash_found
  _size_total=( $(
    du \
      -hs \
      "${_cache_dir}")
  )
  for _file in "${_cache_dir}/"*; do
    _hash="$(
      basename \
        "${_file}")"
    _hashes+=(
      "${_hash}" 
    ) 
    _hash_found["${_hash}"]=""
  done
  for _file in "${_cache_dir}/"*"/publish/base64/"*"/checkpoint."*; do
    _hash="$(
      basename \
        "$(realpath \
             "$(dirname \
                  "${_file}")/../../..")")"
    if [[ "${_file}" == *".publish" ]]; then
      _hashes_publishing+=(
        "${_hash}"
      )
    fi
    if [[ "${_file}" == *".lock" ]]; then
      _hashes_locking+=(
        "${_hash}"
      )
    fi
    if [[ "${_hash_found["${_hash}"]}" != "true" ]]; then
      _hashes_active+=(
        "${_hash}" 
      ) 
    fi
    _hash_found["${_hash}"]="true"
  done
  _msg=(
    "Total size:"
    "  ${_size_total}"
    "Cached files:"
    "  ${#_hashes[@]}"
    "Active files:"
    "  ${#_hashes_active[@]}"
    "Files currently being published:"
    "  ${#_hashes_publishing[@]}"
    "Files currently being locked:"
    "  ${#_hashes_locking[@]}"
  )
  printf \
    "%s\n" \
    "${_msg[@]}"
}

_stats_file() {
  local \
    _file="${1}" \
    _chunk \
    _chunks=() \
    _chunks_amount \
    _chunks_published \
    _chunks_locked \
    _encoding_dir \
    _encoding_length \
    _encoding_lengths=() \
    _hash \
    _lock_checkpoint_file \
    _msg=() \
    _publish_checkpoint_file
  _hash="$(
    _file_hash \
      "${_file}")"
  printf \
    "%s\n" \
    "SHA256 checksum:" \
    "  ${_hash}"
  _encodings_dir="${_cache_dir}/${_hash}/publish/base64"
  _encoding_lengths+=( $(
    ls \
      "${_encodings_dir}")
  )
  _msg=(
    "Available encoded chunks lengths:"
    "  ${_encoding_lengths[*]}"
  )
  printf \
    "%s\n" \
    "${_msg[@]}"
  for _encoding_length in "${_encoding_lengths[@]}"; do
    _encoding_dir="${_encodings_dir}/${_encoding_length}"
    _publish_checkpoint_file="${_encoding_dir}/checkpoint.publish"
    _lock_checkpoint_file="${_encoding_dir}/checkpoint.lock"
    _chunks_prefix="${_encoding_dir}/${_hash}.base64"
    for _chunk in "${_chunks_prefix}"*; do
      _chunks+=(
        "${_chunk}"
      )
    done
    _chunks_amount="${#_chunks[@]}"
    _msg=(
      "Chunk length:"
      "  ${_encoding_length}"
      "Total chunks:"
      "  ${_chunks_amount}"
    )
    if [[ -e "${_publish_checkpoint_file}" ]]; then
      _chunks_published="$(
        cat \
          "${_publish_checkpoint_file}")"
      _percentage_published="$((
        ( "${_chunks_published}" * 100 ) /
          "${_chunks_amount}" ))"
      _msg+=(
        "Chunks published:"
        "  ${_chunks_published} (${_percentage_published}%)"
      )
    fi
    if [[ -e "${_lock_checkpoint_file}" ]]; then
      _chunks_locked="$(
        cat \
          "${_lock_checkpoint_file}")"
      _percentage_locked="$((
        ( "${_chunks_locked}" * 100 ) /
          "${_chunks_amount}" ))"
      _msg+=(
        "Chunks locked:"
        "  ${_chunks_locked} (${_percentage_locked}%)"
      )
    fi
    printf \
      "%s\n" \
      "${_msg[@]}"
  done
}

